# Copy this file to .env and fill in real values before `docker compose up`.

# --- app-backend ---
PORT=3000
DB_PATH=/data/app.db
# Random long string used to sign dashboard JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme

# Seeded on first boot only (when admin_user table is empty). Change the
# password from the dashboard afterwards; these vars are not read again
# once an admin user exists.
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=changeme

# Base URL the backend uses to reach signal-cli-rest-api. Leave as-is for
# the bundled docker-compose setup.
SIGNAL_API_BASE_URL=http://signal-api:8080

# --- signal-api (bbernhard/signal-cli-rest-api) ---
# MODE tradeoffs (speed and memory both increase down the list):
#   normal            - HTTP polling only, lowest memory, slowest
#   native             - native libsignal, faster send, still polling receive
#   json-rpc           - persistent process, supports websocket receive
#   json-rpc-native     - both native + json-rpc, recommended, ~200-400MB per linked number
SIGNAL_MODE=json-rpc-native
